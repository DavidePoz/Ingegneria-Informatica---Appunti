\ProvidesPackage{doc_style}

% ------------------------------------------------------------------------------------
%                               IMPAGINAZIONE E FONT
% ------------------------------------------------------------------------------------
\RequirePackage[margin=2.8cm]{geometry}
\RequirePackage{libertinus}
\RequirePackage{microtype}
\RequirePackage[dvipsnames, table]{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}

% TikZ e mdframed servono per i box colorati dei teoremi
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage[framemethod=TikZ]{mdframed}
\RequirePackage{thmtools}

% ------------------------------------------------------------------------------------
%                               PALETTE COLORI (NORD)
% ------------------------------------------------------------------------------------
\definecolor{nord0}{HTML}{2E3440}  
\definecolor{nord1}{HTML}{3B4252}
\definecolor{nord2}{HTML}{434C5E}
\definecolor{nord3}{HTML}{4C566A}
\definecolor{nord4}{HTML}{D8DEE9}  
\definecolor{nord5}{HTML}{E5E9F0}
\definecolor{nord6}{HTML}{ECEFF4}
\definecolor{nord7}{HTML}{8FBCBB}  
\definecolor{nord8}{HTML}{88C0D0}  
\definecolor{nord9}{HTML}{81A1C1}  
\definecolor{nord10}{HTML}{5E81AC} 
\definecolor{nord11}{HTML}{BF616A} 
\definecolor{nord12}{HTML}{D08770} 
\definecolor{nord13}{HTML}{EBCB8B} 
\definecolor{nord14}{HTML}{A3BE8C} 
\definecolor{nord15}{HTML}{B48EAD} 

% ------------------------------------------------------------------------------------
%                               MIGLIORAMENTI TIPOGRAFICI
% ------------------------------------------------------------------------------------

% --- Numeri di pagina
\setlength{\headheight}{14pt}
\addtolength{\topmargin}{-2pt}
\pagestyle{fancy}
\fancyhf{}                                                      
\fancyhead[L]{\small\sffamily\textcolor{nord3}{\leftmark}}      
\fancyhead[R]{\small\sffamily\textcolor{nord3}{\thepage}}       
\renewcommand{\headrulewidth}{0.4pt}                            
\renewcommand{\headrule}{\color{nord4}\hrule width\headwidth height\headrulewidth \vskip-\headrulewidth}

% --- Capitoli
\titleformat{\chapter}[block]                           
  {\normalfont\sffamily}                                        
  {\fontsize{60}{72}\selectfont\color{nord11}\thechapter}       
  {1em}                                                         
  {\textcolor{nord3}{\rule[-2ex]{1.5pt}{11ex}}\hspace{1.5em}\fontsize{30}{36}\selectfont\color{black}\MakeUppercase}                                                             
  [\vspace{10pt}]                                               

% --- Sezioni e Sottosezioni
\titleformat{\section}
    {\normalfont\Large\bfseries\sffamily\color{nord0}}
    {\thesection}{1em}{}
  
\titleformat{\subsection}
    {\normalfont\large\bfseries\sffamily\color{nord0}}
    {\thesubsection}{1em}{}

% --- Stile per didascalie ---
\captionsetup{
    font=small,
    labelfont={bf,sf,color=nord10},     
    format=hang,                        
    justification=justified
}

% ------------------------------------------------------------------------------------
%                               STILE AMBIENTI (TEOREMI)
% ------------------------------------------------------------------------------------
\AtBeginEnvironment{mdframed}{\tikzexternaldisable}
\AtEndEnvironment{mdframed}{\tikzexternalenable}
\mdfsetup{skipabove=1em, skipbelow=0em, innertopmargin=5pt, innerbottommargin=6pt}
\theoremstyle{definition}

% Stile Verde
\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{nord14!70!black},
    bodyfont=\normalfont,
    mdframed={
        linewidth=2pt, rightline=false, topline=false, bottomline=false,
        linecolor=nord14, backgroundcolor=nord14!5,
    }
]{thmgreenbox}

% Stile Rosso
\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{nord11!70!black},
    bodyfont=\normalfont,
    mdframed={
        linewidth=2pt, rightline=false, topline=false, bottomline=false,
        linecolor=nord11, backgroundcolor=nord11!5,
    }
]{thmredbox}

% Stile Blu
\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{nord9!70!black},
    bodyfont=\normalfont,
    mdframed={
        linewidth=2pt, rightline=false, topline=false, bottomline=false,
        linecolor=nord9, backgroundcolor=nord9!5,
    }
]{thmbluebox}

% Stile Arancione (Warning)
\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{nord12!70!black},
    bodyfont=\normalfont, numbered=no,
    mdframed={
        linewidth=2pt, rightline=false, topline=false, bottomline=false,
        linecolor=nord12, backgroundcolor=nord12!5,
    },
]{thmwarningbox}

% Stile Blu chiaro (Nota)
\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{nord8!70!black},
    bodyfont=\normalfont, numbered=no,
    mdframed={
        linewidth=2pt, rightline=false, topline=false, bottomline=false,
        linecolor=nord8, backgroundcolor=nord8!5,
    },
]{thmexplanationbox}

% --- Dichiarazione degli ambienti ---
\declaretheorem[style=thmgreenbox, numbered=no, name=Definizione]{definition}       
\declaretheorem[style=thmbluebox, numbered=no, name=Esempio]{exa}                   
\declaretheorem[style=thmbluebox, numbered=no, name=Esercizio]{exe}                 
\declaretheorem[style=thmredbox, numbered=no, name=Proposizione]{prop}              
\declaretheorem[style=thmredbox, numbered=no, name=Teorema]{theorem}                
\declaretheorem[style=thmwarningbox, numbered=no, name=Attenzione]{warning}            
\declaretheorem[style=thmexplanationbox, numbered=no, name=Nota]{remark}            

\endinput
